{
  "name": "pi-diff-review",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "relay": "node ./bin/glimpse-relay.mjs --docker",
    "relay:install": "node ./scripts/glimpse-relay-launch-agent.mjs install",
    "relay:uninstall": "node ./scripts/glimpse-relay-launch-agent.mjs uninstall",
    "relay:status": "node ./scripts/glimpse-relay-launch-agent.mjs status",
    "relay:env": "node ./scripts/glimpse-relay-launch-agent.mjs env",
    "bridge": "npm run relay --",
    "bridge:install": "npm run relay:install --",
    "bridge:uninstall": "npm run relay:uninstall --",
    "bridge:status": "npm run relay:status --",
    "bridge:env": "npm run relay:env --",
    "check": "tsgo --noEmit",
    "prepare": "node ./scripts/prepare.mjs"
  },
  "bin": {
    "glimpse-relay": "./bin/glimpse-relay.mjs",
    "pi-diff-review-bridge": "./bin/pi-diff-review-bridge.mjs",
    "pi-diff-view-bridge": "./bin/pi-diff-review-bridge.mjs"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "optionalDependencies": {
    "glimpseui": "^0.8.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@typescript/native-preview": "^7.0.0-dev.20260313.1",
    "husky": "^9.1.7",
    "typescript": "^5.9.2"
  }
}
