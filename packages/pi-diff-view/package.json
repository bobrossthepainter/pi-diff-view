{
  "name": "@bobrossthepainter/pi-diff-view",
  "version": "0.2.0",
  "type": "module",
  "description": "Pi extension for native diff review windows",
  "keywords": [
    "pi-package",
    "pi-extension",
    "diff-review",
    "glimpse-relay"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bobrossthepainter/pi-diff-view.git",
    "directory": "packages/pi-diff-view"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "web",
    "README.md"
  ],
  "scripts": {
    "check": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bobrossthepainter/glimpse-relay-client": "^0.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
